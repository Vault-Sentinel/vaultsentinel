# MCP Server Configuration
MCP_API_KEY=your-mcp-server-api-key-here

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai  # or "gemini"
USE_REAL_LLM=true  # Set to false for simulation mode

# Model Selection (Cost Optimization)
# OpenAI Models (cheapest to most expensive):
# - gpt-3.5-turbo (cheapest, good for most tasks)
# - gpt-3.5-turbo-16k (cheaper than gpt-4, good for longer contexts)
# - gpt-4 (most expensive, highest quality)
# - gpt-4-turbo (expensive, very high quality)
OPENAI_MODEL=gpt-3.5-turbo

# Gemini Models (cheapest to most expensive):
# - gemini-1.5-flash (cheapest, fastest)
# - gemini-1.5-pro (more expensive, higher quality)
# - gemini-1.0-pro (legacy, cheaper than 1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Cost Optimization Settings
MAX_TOKENS=100  # Limit response length to reduce costs
TEMPERATURE=0.1  # Lower temperature for more consistent, shorter responses
ENABLE_CACHING=true  # Cache responses to avoid duplicate API calls

# Server Configuration
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_DEBUG=false
