# Cloud Run optimized Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install additional LLM dependencies
RUN pip install --no-cache-dir openai google-generativeai

# Copy application code
COPY . .

# Create non-root user
RUN useradd -m -u 1000 mcpuser && chown -R mcpuser:mcpuser /app
USER mcpuser

# Cloud Run specific configurations
ENV PORT=9000
ENV HOST=0.0.0.0
ENV PYTHONUNBUFFERED=1

# Health check endpoint (Cloud Run will use this)
EXPOSE 9000

# Use enhanced server for Cloud Run
CMD ["python", "enhanced_server.py"]
