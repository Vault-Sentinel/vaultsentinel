# GitHub Configuration
GITHUB_REPO=org/example-repo
GITHUB_TOKEN=ghp_your_token_here

# Scanning Configuration
POLL_INTERVAL_SECONDS=120
SCAN_DEPTH_COMMITS=10

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Remediation Configuration
REMEDIATION_ENABLED=false
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Detection Configuration
DETECTION_ENTROPY_THRESHOLD=4.5
ALLOWLIST_PATHS=["/tests/", "/examples/", "/fixtures/"]
DENYLIST_PATTERNS=["dummy", "example", "test", "mock"]

# Database
DATABASE_URL=sqlite:///./vaultsentinel.db


# MCP (Model Context Protocol) Configuration
MCP_BASE_URL=https://vaultsentinel-mcp-923046029861.us-west1.run.app  # MCP server URL
MCP_AUTH_TYPE=api_key  # api_key, oauth2, mtls, none
MCP_API_KEY=mcp-prod-REPLACE_ME  # API key for MCP server
MCP_TIMEOUT_SECONDS=30  # Request timeout in seconds
DEMO_MODE=false  # Set to true for demo mode with mock responses

# OAuth2 Configuration (only needed if MCP_AUTH_TYPE=oauth2)
# MCP_OAUTH_TOKEN_URL=https://auth.example.com/token  # OAuth2 token endpoint
# MCP_CLIENT_ID=your_oauth_client_id  # OAuth2 client ID
# MCP_CLIENT_SECRET=your_oauth_client_secret  # OAuth2 client secret

# MCP Proxy Configuration
MCP_TIMEOUT_MS=20000  # Request timeout in milliseconds
MCP_RETRIES=2  # Number of retries for failed requests
MCP_AUTH_HEADER=Authorization  # Header name for authentication (default: Authorization)

# Web Configuration
FRONTEND_ORIGIN=http://localhost:3000  # Frontend origin for CORS
BACKEND_ORIGIN=http://localhost:8000  # Backend origin for CORS
NODE_ENV=development  # Environment mode
