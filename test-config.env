# GitHub Configuration
GITHUB_REPO=Vault-Sentinel/test-VS
GITHUB_TOKEN=ghp_your_token_here

# Scanning Configuration
POLL_INTERVAL_SECONDS=60
SCAN_DEPTH_COMMITS=5

# Slack Configuration (optional for testing)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Remediation Configuration
REMEDIATION_ENABLED=false
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret

# Detection Configuration
DETECTION_ENTROPY_THRESHOLD=4.5
ALLOWLIST_PATHS=["/tests/", "/examples/", "/fixtures/"]
DENYLIST_PATTERNS=["dummy", "example", "test", "mock"]

# Database
DATABASE_URL=sqlite:///./vaultsentinel.db

# LLM Configuration (optional for testing)
LLM_CLASSIFIER_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
GEMINI_MODEL=gemini-1.5-flash
LLM_CONFIDENCE_THRESHOLD=0.7
